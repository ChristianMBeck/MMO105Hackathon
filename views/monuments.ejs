<%- include("partials/top") %>

<header class="page-head">
  <div>
    <p class="eyebrow">Check-in</p>
    <h1>Famous monuments</h1>
    <p class="lede">Adds the monument to your stats.</p>
  </div>
</header>

<form class="card-panel form-panel" method="post" action="/monuments/upload" enctype="multipart/form-data">
  <label class="form-label" for="photo">Monument photo</label>
  <input class="form-control mb-3" type="file" id="photo" name="photo" accept="image/*" required />
  <button class="btn btn-wp" type="submit">Identify visit</button>
</form>

<% if (typeof pending !== "undefined" && pending) { %>
  <section class="card-panel monument-confirm">
    <img src="/monument-photos/<%= pending.photoPath %>" alt="Uploaded monument photo" />
    <div>
      <h2>Which monument is this?</h2>
      <div class="monument-choices">
        <% for (const choice of pending.candidates) { %>
          <form method="post" action="/monuments/confirm">
            <input type="hidden" name="famousId" value="<%= choice.famousId %>" />
            <button class="btn btn-wp" type="submit">
              <%= choice.name %>
              <small><%= choice.country %></small>
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </section>
<% } %>

<% if (typeof latest !== "undefined" && latest) { %>
  <section class="card-panel monument-latest">
    <img src="/monument-photos/<%= latest.photoPath %>" alt="<%= latest.name %>" />
    <div>
      <p class="eyebrow"><%= latest.newVisit ? "New visit" : "Already in your log" %></p>
      <h2><%= latest.name %></h2>
      <p class="lede"><%= latest.country %></p>
      <% if (latest.distanceMeters != null && latest.distanceMeters !== "") { %>
        <p class="hint"><%= latest.distanceMeters %> m from listed coordinates</p>
      <% } else if (latest.source === "vision") { %>
        <p class="hint">Identified from the photo</p>
      <% } %>
    </div>
  </section>
<% } %>

<section class="section-head">
  <h2>Your monuments</h2>
  <span class="hint"><%= entries.length %> stored</span>
</section>

<% if (!entries.length) { %>
  <div class="empty card-panel">
    <i class="bi bi-camera"></i>
    <p>No check-ins yet.</p>
  </div>
<% } else { %>
  <div class="monument-grid">
    <% for (const entry of entries) { %>
      <article class="card-panel monument-card">
        <% if (entry.photoPath) { %>
          <img src="/monument-photos/<%= entry.photoPath %>" alt="<%= entry.name %>" />
        <% } %>
        <h3><%= entry.name %></h3>
        <p><%= entry.country || "Monument" %></p>
      </article>
    <% } %>
  </div>
<% } %>

<%- include("partials/bottom") %>
