<%- include("partials/top") %>

<header class="page-head">
  <div>
    <p class="eyebrow">Ladder</p>
    <h1>Ranks, from Wanderer to Odyssey</h1>
    <p class="lede">Same idea as gym ranks: divisions inside each tier, then a new metal. Score is a weighted mix of distance, places, and how you moved.</p>
  </div>
</header>

<section class="you-are card-panel">
  <%- include("partials/rank-medal") %>
  <div>
    <p class="eyebrow">Currently</p>
    <h2><%= rank.label %></h2>
    <p>Score <%= formatScore(traveler.score) %>. <%= rank.next ? formatScore(rank.pointsToNext) + " XP until " + rank.next.label + "." : "You are at the top of the published ladder." %></p>
  </div>
</section>

<ol class="ladder">
  <% for (const step of LADDER) { %>
    <li class="<%= step.key === rank.key ? 'current' : '' %> <%= traveler.score >= step.minScore ? 'unlocked' : 'locked' %>">
      <span class="swatch" style="background: <%= step.color %>; box-shadow: 0 0 0 3px <%= step.ring %>"></span>
      <div>
        <strong><%= step.label %></strong>
        <small><%= formatScore(step.minScore) %> XP to unlock</small>
      </div>
      <% if (step.key === rank.key) { %><span class="pill">You</span><% } %>
    </li>
  <% } %>
</ol>

<section class="card-panel">
  <h2 class="form-section" style="margin-top:0">How score is built</h2>
  <div class="weight-table">
    <% for (const meta of STAT_META) { %>
      <div>
        <span><i class="bi bi-<%= meta.icon %>"></i> <%= meta.label %></span>
        <strong><%= WEIGHTS[meta.key] %> XP</strong>
      </div>
    <% } %>
  </div>
  <p class="hint">Tune weights in <code>db.js</code> — the hub, logger, and board all read from that file.</p>
</section>

<%- include("partials/bottom") %>
