<%- include("partials/guest-top") %>

<section class="auth-card card-panel">
  <p class="eyebrow">Welcome back</p>
  <h1>Log in</h1>
  <p class="lede">Demo login. Any values work.</p>
  <form method="post" action="/login">
    <label class="form-label" for="email">Email</label>
    <input class="form-control mb-3" id="email" name="email" type="email" placeholder="you@example.com" />
    <label class="form-label" for="password">Password</label>
    <input class="form-control mb-4" id="password" name="password" type="password" placeholder="••••••••" />
    <div class="landing-actions">
      <button class="btn btn-wp" type="submit">Log in</button>
      <a class="btn btn-ghost" href="/signup">Create account</a>
    </div>
  </form>
</section>

<%- include("partials/guest-bottom") %>
