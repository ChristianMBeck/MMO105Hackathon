<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-black text-light">
    <nav class="navbar navbar-dark border-bottom border-secondary">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">Travel Log</a>
        <span class="small text-secondary">
          <%= dbReady ? `Connected · ${dbName}` : "Database offline" %>
        </span>
      </div>
    </nav>

    <main class="container py-5">
      <p class="text-uppercase small text-secondary mb-1">Global board</p>
      <h1 class="display-5 fw-bold mb-4">Leaderboard</h1>

      <% if (typeof error !== "undefined" && error) { %>
        <div class="alert alert-warning"><%= error %></div>
      <% } %>

      <% if (!leaderboard.length) { %>
        <p class="text-secondary">No travelers yet. Run <code>npm test</code> against this database, or add users.</p>
      <% } else { %>
        <div class="list-group">
          <% leaderboard.forEach((row) => { %>
            <a
              class="list-group-item list-group-item-action d-flex justify-content-between align-items-center bg-dark text-light border-secondary"
              href="/hub/<%= row.username %>"
            >
              <span>
                <span class="badge text-bg-warning me-2">#<%= row.rank || "—" %></span>
                <strong><%= row.displayName || row.username %></strong>
                <span class="text-secondary">@<%= row.username %></span>
              </span>
              <span class="fs-5"><%= row.score %></span>
            </a>
          <% }) %>
        </div>
      <% } %>
    </main>
  </body>
</html>
