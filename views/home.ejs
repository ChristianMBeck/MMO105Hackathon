<%- include("partials/guest-top") %>

<section class="landing">
  <p class="eyebrow">Ranked travel</p>
  <h1>Log the miles. Climb the board.</h1>
  <p class="lede landing-copy">Log miles, places, and monuments. Share photos on Social whenever you want — no daily timer, and you can browse before you post.</p>

  <div class="landing-actions">
    <% if (typeof traveler !== "undefined" && traveler) { %>
      <a class="btn btn-wp" href="/hub">Open your hub</a>
      <a class="btn btn-ghost" href="/logout">Sign out</a>
    <% } else { %>
      <a class="btn btn-wp" href="/login">Log in</a>
      <a class="btn btn-ghost" href="/signup">Create account</a>
    <% } %>
  </div>
</section>

<%- include("partials/guest-bottom") %>
