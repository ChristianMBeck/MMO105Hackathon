<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %></title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
  </head>
  <body class="bg-black text-light">
    <nav class="navbar navbar-dark border-bottom border-secondary">
      <div class="container">
        <a class="navbar-brand fw-bold" href="/">Travel Log</a>
        <span class="small text-secondary">
          <%= dbReady ? `Connected · ${dbName}` : "Database offline" %>
        </span>
      </div>
    </nav>

    <main class="container py-5">
      <a class="small text-secondary text-decoration-none" href="/">← Leaderboard</a>
      <p class="text-uppercase small text-secondary mt-3 mb-1">Central hub</p>
      <h1 class="display-5 fw-bold"><%= user.displayName || user.username %></h1>
      <p class="lead text-secondary">
        Score <strong class="text-warning"><%= user.score %></strong>
        · Rank <strong class="text-light">#<%= user.rank || "—" %></strong>
      </p>

      <div class="row g-3 mb-5">
        <% statCards.forEach((card) => { %>
          <div class="col-6 col-md-4">
            <div class="border border-secondary rounded-3 p-3 h-100 bg-dark">
              <div class="small text-secondary"><%= card.label %></div>
              <div class="fs-4 fw-semibold">
                <%= user.stats[card.key] ?? 0 %><%= card.suffix %>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <h2 class="h4 mb-3">Travel log</h2>
      <% if (!logs.length) { %>
        <p class="text-secondary">No trips logged yet.</p>
      <% } else { %>
        <ul class="list-group">
          <% logs.forEach((log) => { %>
            <li class="list-group-item bg-dark text-light border-secondary">
              <div class="d-flex justify-content-between">
                <strong><%= log.title || log.mode %></strong>
                <span>+<%= log.scoreAwarded %> pts</span>
              </div>
              <div class="small text-secondary">
                <%= new Date(log.occurredAt).toLocaleDateString() %>
                · <%= log.mode %>
                · <%= log.distanceMiles %> mi
              </div>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </main>
  </body>
</html>
