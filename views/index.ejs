<%- include("partials/header") %>

<section class="hero">
  <p class="eyebrow">Travel, scored like training</p>
  <h1>Log miles. Climb the board.</h1>
  <p class="lead">
    Travelog is a Liftoff-style tracker for trips instead of workouts. Every mile and
    new place raises your score. Open the hub to see your stats, then log a trip.
  </p>
  <div class="d-flex flex-wrap gap-3">
    <a class="btn btn-accent btn-lg" href="/hub">Open my hub</a>
    <a class="btn btn-outline-light btn-lg" href="/leaderboard">See leaderboard</a>
  </div>
</section>

<section class="row g-4 mt-4">
  <div class="col-md-4">
    <article class="stat-card">
      <h2>Stats that count</h2>
      <p class="text-secondary mb-0">
        Distance, counties, states, monuments, plus miles in car, plane, train, bike, and on foot.
      </p>
    </article>
  </div>
  <div class="col-md-4">
    <article class="stat-card">
      <h2>A living score</h2>
      <p class="text-secondary mb-0">
        Foot and bike miles score highest. First visits to a state, county, or monument add a bonus.
      </p>
    </article>
  </div>
  <div class="col-md-4">
    <article class="stat-card">
      <h2>Global rank</h2>
      <p class="text-secondary mb-0">
        The leaderboard re-ranks every traveler as soon as someone logs a trip.
      </p>
    </article>
  </div>
</section>

<%- include("partials/footer") %>
