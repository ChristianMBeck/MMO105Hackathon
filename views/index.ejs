<%- include("partials/header") %>

<section class="hero">
  <p class="eyebrow">Travel, scored</p>
  <h1>Log the miles. Climb the board.</h1>
  <p class="lead">
    A Liftoff-style hub for travel: every county, state, monument, and mile
    you log raises your score and your global rank.
  </p>
  <div class="d-flex gap-3 flex-wrap">
    <a class="btn btn-accent btn-lg" href="/register">Start logging</a>
    <a class="btn btn-outline-light btn-lg" href="/leaderboard">See rankings</a>
  </div>
</section>

<section class="row g-3 mt-4">
  <div class="col-md-4">
    <article class="stat-card">
      <h2>Nine stats</h2>
      <p>Distance, counties, states, monuments, plus miles by car, air, train, bike, and foot.</p>
    </article>
  </div>
  <div class="col-md-4">
    <article class="stat-card">
      <h2>A real score</h2>
      <p>Harder miles and first-time places are worth more. Repeats do not double-count.</p>
    </article>
  </div>
  <div class="col-md-4">
    <article class="stat-card">
      <h2>Global rank</h2>
      <p>Your hub shows score, rank, and every stat. The leaderboard ranks every traveler.</p>
    </article>
  </div>
</section>

<%- include("partials/footer") %>
