<% const followBoard = typeof followingTravelers !== "undefined" && Array.isArray(followingTravelers) ? followingTravelers : []; %>
<section class="following-board">
  <header class="page-head">
    <div>
      <p class="eyebrow">People you follow</p>
      <h2>Following Leaderboard</h2>
      <% if (typeof traveler !== "undefined" && traveler) { %>
        <p class="lede"><%= followBoard.length %> traveler<%= followBoard.length === 1 ? "" : "s" %></p>
      <% } else { %>
        <p class="lede">Log in to see ranks among people you follow.</p>
      <% } %>
    </div>
  </header>
  <% if (typeof traveler === "undefined" || !traveler) { %>
    <div class="card-panel empty">
      <i class="bi bi-people"></i>
      <p>Log in to see a board of the people you follow.</p>
      <a class="btn btn-ghost" href="/login">Log in</a>
    </div>
  <% } else if (!followBoard.length) { %>
    <div class="card-panel empty">
      <i class="bi bi-people"></i>
      <p>You are not following anyone yet.</p>
      <a class="btn btn-ghost" href="/social">Find travelers</a>
    </div>
  <% } else { %>
    <ol class="board card-panel">
      <% for (const row of followBoard) { %>
        <li>
          <span class="place"><%= row.place %></span>
          <span class="avatar" style="--hue: <%= row.avatarHue %>"><%= row.displayName.slice(0,1) %></span>
          <span class="who">
            <strong><%= row.displayName %></strong>
            <small>@<%= row.handle %> · <%= row.homeBase || "No home base" %></small>
          </span>
          <span class="hidden-sm"><%= formatScore(row.score) %></span>
          <span class="pts"><%= formatScore(row.score) %> XP</span>
        </li>
      <% } %>
    </ol>
  <% } %>
</section>

<section class="section-head">
  <h2>Rank ladder</h2>
</section>

<% if (typeof traveler !== "undefined" && traveler && rank) { %>
<section class="you-are card-panel">
  <%- include("partials/rank-medal") %>
  <div>
    <p class="eyebrow">Currently</p>
    <h2><%= rank.label %></h2>
    <p>Score <%= formatScore(traveler.score) %>. <%= rank.next ? formatScore(rank.pointsToNext) + " XP to " + rank.next.label + "." : "Top of the ladder." %></p>
  </div>
</section>
<% } %>

<ol class="ladder">
  <% const score = typeof traveler !== "undefined" && traveler ? traveler.score : 0; %>
  <% const currentKey = rank && rank.key; %>
  <% for (const step of LADDER) { %>
    <li class="<%= step.key === currentKey ? 'current' : '' %> <%= score >= step.minScore ? 'unlocked' : 'locked' %>">
      <span class="swatch" style="background: <%= step.color %>; box-shadow: 0 0 0 3px <%= step.ring %>"></span>
      <div>
        <strong><%= step.label %></strong>
        <small><%= formatScore(step.minScore) %> XP to unlock</small>
      </div>
      <% if (step.key === currentKey) { %><span class="pill">You</span><% } %>
    </li>
  <% } %>
</ol>

