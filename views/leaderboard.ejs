<%- include("partials/top") %>

<header class="page-head">
  <div>
    <p class="eyebrow">Global board</p>
    <h1>Who is covering the most ground</h1>
    <p class="lede"><% if (typeof traveler !== "undefined" && traveler) { %>You are <strong>#<%= position %></strong> of <%= total %> travelers. Rank is score, then who got there first.<% } else { %><%= total %> travelers on the board. Rank is score, then who got there first.<% } %></p>
  </div>
  <form class="search-form" method="get" action="/leaderboard">
    <i class="bi bi-search"></i>
    <input class="form-control" name="q" value="<%= q %>" placeholder="Search name, handle, city" />
  </form>
</header>

<% if (!travelers.length) { %>
  <div class="card-panel empty">
    <i class="bi bi-binoculars"></i>
    <p>No travelers match that search.</p>
    <a class="btn btn-ghost" href="/leaderboard">Clear search</a>
  </div>
<% } else { %>
  <% const podium = travelers.slice(0, 3); %>
  <% if (!q && podium.length === 3) { %>
    <ol class="podium">
      <% const podiumOrder = [podium[1], podium[0], podium[2]]; %>
      <% for (const row of podiumOrder) { %>
        <li class="<%= traveler && String(row._id) === String(traveler._id) ? 'me' : '' %> place-<%= row.place %>">
          <span class="avatar lg" style="--hue: <%= row.avatarHue %>"><%= row.displayName.slice(0,1) %></span>
          <strong><%= row.displayName %></strong>
          <small>@<%= row.handle %></small>
          <span class="badge-rank"><%= rankFromScore(row.score).label %></span>
          <em><%= formatScore(row.score) %></em>
        </li>
      <% } %>
    </ol>
  <% } %>

  <ol class="board card-panel">
    <% for (const row of travelers) { %>
      <li class="<%= traveler && String(row._id) === String(traveler._id) ? 'me' : '' %>">
        <span class="place"><%= row.place %></span>
        <span class="avatar" style="--hue: <%= row.avatarHue %>"><%= row.displayName.slice(0,1) %></span>
        <span class="who">
          <strong><%= row.displayName %></strong>
          <small>@<%= row.handle %> · <%= row.homeBase || "No home base" %></small>
        </span>
        <span class="hidden-sm"><%= formatScore(row.score) %></span>
        <span class="pts"><%= formatScore(row.score) %> XP</span>
      </li>
    <% } %>
  </ol>
<% } %>

<%- include("partials/bottom") %>
